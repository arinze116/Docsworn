[Unit]
Description=Docsworn outbound HTTPS tunnel
After=docsworn-worker.service nginx.service network-online.target
Wants=docsworn-worker.service nginx.service network-online.target

[Service]
Type=simple
User=ubuntu
Group=www-data
ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:8788 --no-autoupdate --no-prechecks --loglevel info
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
