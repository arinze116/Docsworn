[Unit]
Description=Docsworn hosted Kane worker
Requires=docker.service docsworn-network.service
After=docker.service docsworn-network.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=www-data
SupplementaryGroups=docker
WorkingDirectory=/home/ubuntu/Docsworn
EnvironmentFile=/etc/docsworn-worker.env
EnvironmentFile=-/etc/docsworn-worker-mirror.env
ExecStart=/usr/bin/node /home/ubuntu/Docsworn/dist/hosted-worker.js
Restart=on-failure
RestartSec=5
RuntimeDirectory=docsworn-worker
RuntimeDirectoryMode=0750
StateDirectory=docsworn-worker
StateDirectoryMode=0700
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.testmuai /var/lib/docsworn-worker /run/docsworn-worker
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
